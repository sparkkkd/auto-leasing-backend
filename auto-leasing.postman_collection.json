		{
			"name": "Deals",
			"item": [
				{
					"name": "Get All Deals (with filters)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.expect(pm.response.code).to.equal(200));",
									"const res = pm.response.json();",
									"pm.test('Has data array and total', () => {",
									"    pm.expect(res).to.have.property('data').that.is.an('array');",
									"    pm.expect(res).to.have.property('total').that.is.a('number');",
									"});",
									"pm.test('Deals include related entities', () => {",
									"    if (res.data.length > 0) {",
									"        const deal = res.data[0];",
									"        pm.expect(deal).to.have.property('client');",
									"        pm.expect(deal).to.have.property('investor');",
									"        pm.expect(deal).to.have.property('car');",
									"    }",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/deals?page=1&limit=10&status=ACTIVE",
							"host": [
