									"if (pm.response.code === 200) {",
									"    pm.environment.unset('dealId');",
									"    console.log('✅ Car status should be IN_STOCK now');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/deals/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"deals",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{dealId}}"
								}
							]
						},
						"description": "Удаляет сделку только если нет платежей. Машина возвращается в IN_STOCK. Если есть платежи — используйте отмену (CANCELLED) вместо удаления."
					}
				}
			]
		}
	]
}