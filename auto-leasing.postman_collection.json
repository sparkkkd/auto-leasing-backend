		{
			"name": "Payments",
			"item": [
				{
					"name": "Get All Payments (with filters)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.expect(pm.response.code).to.equal(200));",
									"const res = pm.response.json();",
									"pm.test('Has data array and total', () => {",
									"    pm.expect(res).to.have.property('data').that.is.an('array');",
									"    pm.expect(res).to.have.property('total').that.is.a('number');",
									"});",
									"pm.test('Amount is number (not Decimal)', () => {",
									"    if (res.data.length > 0) {",
									"        pm.expect(typeof res.data[0].amount).to.equal('number');",
									"    }",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/payments?dealId={{dealId}}&direction=CLIENT_TO_COMPANY&page=1&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"payments"
							],
							"query": [
								{
									"key": "dealId",
									"value": "{{dealId}}"
								},
								{
									"key": "direction",
									"value": "CLIENT_TO_COMPANY"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Фильтры: dealId, direction (CLIENT_TO_COMPANY / COMPANY_TO_INVESTOR), dateFrom, dateTo. Суммы возвращаются как number, а не Decimal."
					}
				},
