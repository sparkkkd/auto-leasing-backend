									"    console.log('✅ Deal ID saved:', res.id);",
									"    console.log('💡 Car status should be IN_WORK now');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"carId\": \"{{carId}}\",\n  \"investorId\": \"{{investorId}}\",\n  \"contractNumber\": \"LEASE-2026-000001\",\n  \"startDate\": \"2026-11-22T00:00:00.000Z\",\n  \"endDate\": \"2028-11-22T00:00:00.000Z\",\n  \"clientTotalAmount\": 2800000,\n  \"investorTotalAmount\": 2500000,\n  \"status\": \"ACTIVE\",\n  \"notes\": \"Лизинг Toyota Camry на 2 года\"\n}"
						},
