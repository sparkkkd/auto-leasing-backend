{
	"info": {
		"name": "Auto Leasing API",
		"description": "API для системы лизинга автомобилей",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "{{backendUrl}}",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const response = pm.response.json();",
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    pm.environment.set('accessToken', response.accessToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						}
					}
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						}
					}
				},
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"manager@example.com\",\n  \"password\": \"manager123\",\n  \"name\": \"Manager User\",\n  \"role\": \"MANAGER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						}
					}
				}
			]
		},
		{
			"name": "Clients",
			"item": [
				{
					"name": "Get All Clients (with search & pagination)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', () => pm.expect(pm.response.code).to.equal(200));",
									"const res = pm.response.json();",
									"pm.test('Has data array and total', () => {",
									"    pm.expect(res).to.have.property('data').that.is.an('array');",
									"    pm.expect(res).to.have.property('total').that.is.a('number');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/clients?page=1&limit=10&search=Иван",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"clients"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "search",
									"value": "Иван"
								}
							]
						},
						"description": "Поиск работает по каждому слову отдельно. Попробуй 'Иванов Иван' или '+7 999'."
					}
				},
				{
					"name": "Create Client",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"    const res = pm.response.json();",
									"    pm.environment.set('clientId', res.id);",
									"    console.log('✅ Client ID saved to environment:', res.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Иван\",\n  \"lastName\": \"Иванов\",\n  \"middleName\": \"Иванович\",\n  \"phone\": \"+79991234567\",\n  \"email\": \"ivanov@example.com\",\n  \"passportData\": \"4500 123456, выдан ОВД Тверского района\",\n  \"address\": \"г. Москва, ул. Тверская, д. 1\",\n  \"notes\": \"Тестовый клиент\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/clients",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"clients"
							]
						}
					}
				},
				{
					"name": "Get Client By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/clients/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"clients",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{clientId}}"
								}
							]
						}
					}
				},
				{
					"name": "Update Client",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"+79999999999\",\n  \"notes\": \"Обновленные заметки после звонка\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/clients/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"clients",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{clientId}}"
								}
							]
						}
					}
				},
				{
					"name": "Delete Client",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.environment.unset('clientId');",
									"    console.log('✅ Client ID cleared from environment');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/clients/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"clients",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{clientId}}"
								}
							]
						},
						"description": "Удаляет клиента только если у него НЕТ сделок. Требует роль ADMIN."
					}
				}
			]
		}
	]
}