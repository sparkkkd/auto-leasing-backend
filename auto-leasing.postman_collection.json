								"exec": [
									"if (pm.response.code === 201) {",
									"    const res = pm.response.json();",
									"    pm.environment.set('paymentId', res.id);",
									"    console.log('✅ Payment ID saved:', res.id);",
									"    console.log('💰 Amount:', res.amount);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dealId\": \"{{dealId}}\",\n  \"direction\": \"CLIENT_TO_COMPANY\",\n  \"amount\": 50000,\n  \"paidAt\": \"2026-11-22T00:00:00.000Z\",\n  \"comment\": \"Ежемесячный платеж за ноябрь\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/payments",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"payments"
							]
						},
						"description": "Платеж от клиента компании. Проверяет существование сделки. Сумма должна быть > 0."
