				},
				{
					"name": "Create Payment (COMPANY_TO_INVESTOR)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"    pm.environment.set('paymentToInvestorId', pm.response.json().id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dealId\": \"{{dealId}}\",\n  \"direction\": \"COMPANY_TO_INVESTOR\",\n  \"amount\": 45000,\n  \"paidAt\": \"2026-11-22T00:00:00.000Z\",\n  \"comment\": \"Платеж инвестору за ноябрь\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/payments",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"payments"
							]
						},
						"description": "Платеж компании инвестору. Создается второй платеж по той же сделке для демонстрации обоих направлений."
					}
				},
				{
					"name": "Get Payment By ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const res = pm.response.json();",
									"    pm.test('Has deal info', () => {",
									"        pm.expect(res).to.have.property('deal');",
									"        pm.expect(res.deal).to.have.property('contractNumber');",
									"    });",
									"    pm.test('Has documents array', () => {",
									"        pm.expect(res).to.have.property('documents').that.is.an('array');",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/payments/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"payments",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{paymentId}}"
								}
							]
						},
						"description": "Возвращает детали платежа с информацией о сделке и списком прикрепленных документов."
					}
				},
				{
					"name": "Update Payment",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
