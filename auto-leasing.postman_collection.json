						"url": {
							"raw": "{{baseUrl}}/payments/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"payments",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "{{paymentId}}"
								}
							]
						},
						"description": "Можно менять: direction, amount, paidAt, comment. Нельзя менять dealId (платеж привязан к сделке)."
					}
				},
				{
					"name": "Delete Payment",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
