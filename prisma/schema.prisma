generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  name     String
  role     UserRole @default(MANAGER)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  expenses      Expense[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============ DOMAIN ============

model Client {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  middleName   String?
  phone        String
  email        String? @unique
  passportData String
  address      String

  comments String?
  notes    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars      Car[]
  deals     Deal[]
  documents Document[]

  @@map("clients")
}

model Investor {
  id            String       @id @default(cuid())
  name          String
  type          InvestorType
  contactPerson String?
  phone         String?
  email         String?      @unique
  bankDetails   String?
  comments      String?
  notes         String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals     Deal[]
  documents Document[]

  @@map("investors")
}

enum InvestorType {
  INDIVIDUAL
  COMPANY
  BANK
}

model Car {
  id            String    @id @default(cuid())
  make          String
  model         String
  year          Int
  vin           String?   @unique
  licensePlate  String?   @unique
  color         String?
  equipment     String?
  showroom      String?
  comments      String?
  notes         String[]
  status        CarStatus @default(IN_STOCK)
  purchasePrice Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals Deal[]

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  expenses  Expense[]
  documents Document[]

  @@map("cars")
}

enum CarStatus {
  IN_STOCK
  IN_WORK
  RESERVED
  SOLD
  REPAIR
  IN_PURCHASE
  FOR_ISSUE
  SEIZED
}

model Deal {
  id String @id @default(cuid())

  contractNumber String   @unique
  startDate      DateTime
  endDate        DateTime
  term           Int
  firstPayment   Decimal
  monthlyPayment Decimal
  finalCarPrice  Decimal

  clientTotalAmount   Decimal @db.Decimal(12, 2)
  investorTotalAmount Decimal @db.Decimal(12, 2)

  payments  Payment[]
  documents Document[]

  status DealStatus @default(ACTIVE)

  comments String?
  notes    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])

  carId String
  car   Car    @relation(fields: [carId], references: [id])

  contractScanId String?
  contractScan   Document? @relation("DealContractScan", fields: [contractScanId], references: [id])

  investorContractScanId String?
  investorContractScan   Document? @relation("DealInvestorContractScan", fields: [investorContractScanId], references: [id])

  @@map("deals")
}

enum DealStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  TERMINATED
}

model Payment {
  id String @id @default(cuid())

  direction   PaymentDirection
  amount      Decimal          @db.Decimal(12, 2)
  paymentDate DateTime

  comments String?
  notes    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id])

  documents Document[]

  @@map("payments")
}

enum PaymentDirection {
  CLIENT_TO_COMPANY
  COMPANY_TO_INVESTOR
}

model Document {
  id String @id @default(cuid())

  fileName     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String

  type DocumentType

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  investorId String?
  investor   Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  carId String?
  car   Car?    @relation(fields: [carId], references: [id], onDelete: SetNull)

  dealsAsContractScan         Deal[] @relation("DealContractScan")
  dealsAsInvestorContractScan Deal[] @relation("DealInvestorContractScan")

  expiresAt DateTime?

  comments String?
  notes    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

enum DocumentType {
  CLIENT_DOCUMENT
  INVESTOR_DOCUMENT
  CONTRACT_SCAN
  PAYMENT_RECEIPT
  PTS
  STS
  INSURANCE
  INVESTMENT_CONTRACT
  DCP
  OTHER
}

// ============ AUDIT ============

model AuditLog {
  id String @id @default(cuid())

  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     AuditAction
  entityType EntityType
  entityId   String
  changes    Json        @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

model Expense {
  id       String      @id @default(cuid())
  type     ExpenseType
  note     String
  amount   Decimal
  carId    String?
  car      Car?        @relation(fields: [carId], references: [id], onDelete: SetNull)
  authorId String
  author   User        @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EntityType {
  USER
  CLIENT
  INVESTOR
  CAR
  DEAL
  PAYMENT
  DOCUMENT
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum ExpenseType {
  CAR
  RENT
  OTHER
}
