generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  name     String
  role     UserRole @default(MANAGER)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============ DOMAIN ============

model Client {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  middleName   String?
  phone        String
  email        String? @unique
  passportData String
  address      String
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals Deal[]

  @@map("clients")
}

model Investor {
  id            String       @id @default(cuid())
  name          String
  type          InvestorType
  contactPerson String?
  phone         String?
  email         String?      @unique
  bankDetails   String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals Deal[]

  @@map("investors")
}

enum InvestorType {
  INDIVIDUAL
  COMPANY
  BANK
}

model Car {
  id            String    @id @default(cuid())
  make          String
  model         String
  year          Int
  vin           String    @unique
  licensePlate  String?   @unique
  color         String?
  status        CarStatus @default(IN_STOCK)
  purchasePrice Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal Deal?

  @@map("cars")
}

enum CarStatus {
  IN_STOCK
  IN_WORK
  RESERVED
  SOLD
  REPAIR
}

model Deal {
  id String @id @default(cuid())

  clientId   String
  carId      String @unique
  investorId String

  contractNumber String   @unique
  startDate      DateTime
  endDate        DateTime

  clientTotalAmount   Decimal @db.Decimal(12, 2)
  investorTotalAmount Decimal @db.Decimal(12, 2)

  status DealStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  car       Car        @relation(fields: [carId], references: [id], onDelete: Cascade)
  investor  Investor   @relation(fields: [investorId], references: [id], onDelete: Cascade)
  payments  Payment[]
  documents Document[]

  @@map("deals")
}

enum DealStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model Payment {
  id     String @id @default(cuid())
  dealId String

  direction PaymentDirection
  amount    Decimal          @db.Decimal(12, 2)
  paidAt    DateTime

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal      Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("payments")
}

enum PaymentDirection {
  CLIENT_TO_COMPANY
  COMPANY_TO_INVESTOR
}

model Document {
  id        String  @id @default(cuid())
  paymentId String?
  dealId    String?

  fileName     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String

  type DocumentType

  createdAt DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("documents")
}

enum DocumentType {
  CLIENT_DOCUMENT
  INVESTOR_DOCUMENT
  CONTRACT_SCAN
  PAYMENT_RECEIPT
  OTHER
}

// ============ AUDIT ============

model AuditLog {
  id String @id @default(cuid())

  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     AuditAction
  entityType EntityType
  entityId   String
  changes    Json        @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

enum EntityType {
  USER
  CLIENT
  INVESTOR
  CAR
  DEAL
  PAYMENT
  DOCUMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}
